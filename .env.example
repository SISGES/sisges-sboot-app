DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sisges?sslmode=disable
SECURITY_JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
SISGES_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
SISGES_R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
SISGES_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
SISGES_R2_BUCKET=sisges-prd
SISGES_R2_REGION=auto
SISGES_SEED_ENABLED=false
SISGES_DB_MAX_CONNECTIONS=6
GOMEMLIMIT_BYTES=167772160
GOGC_PERCENT=75
